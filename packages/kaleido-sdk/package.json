{
  "name": "@kaleido-io/kaleido-sdk",
  "version": "1.0.0-rc1",
  "description": "Kaleido SDK umbrella: KaleidoClient convenience facade and project scaffolding CLI",
  "type": "module",
  "main": "dist/src/index.js",
  "types": "dist/src/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/src/index.js",
      "types": "./dist/src/index.d.ts"
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kaleido-io/kaleido-sdk-typescript.git"
  },
  "keywords": ["kaleido", "sdk", "typescript", "blockchain", "workflow-engine", "asset-manager"],
  "author": "Kaleido",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=20.19.0"
  },
  "bin": {
    "ksdk": "./bin/ksdk.js"
  },
  "files": [
    "dist/**/*",
    "bin/**/*",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup",
    "clean": "rm -rf dist",
    "dev": "tsc --watch",
    "test": "jest --coverage"
  },
  "dependencies": {
    "@kaleido-io/workflow-engine-sdk": "^1.0.0-rc1",
    "@kaleido-io/asset-manager-sdk": "^1.0.0-rc1",
    "@kaleido-io/connector-sdk": "^0.1.0-rc1"
  },
  "devDependencies": {
    "@kaleido-io/core": "file:../../internal/core",
    "@jest/globals": "^30.0.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^22.0.0",
    "jest": "^30.0.0",
    "ts-jest": "^29.1.0",
    "tsc-esm-fix": "^3.1.2",
    "tsup": "^8.5.1",
    "typescript": "^5.2.0"
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "node",
    "roots": [
      "<rootDir>/src"
    ],
    "testMatch": [
      "**/?(*.)+(spec|test).ts"
    ],
    "transform": {
      "^.+\\.ts$": "ts-jest"
    },
    "moduleNameMapper": {
      "^@kaleido-io/workflow-engine-sdk$": "<rootDir>/../workflow-engine-sdk/src/index.ts",
      "^@kaleido-io/asset-manager-sdk$": "<rootDir>/../asset-manager-sdk/src/index.ts",
      "^@kaleido-io/connector-sdk$": "<rootDir>/../connector-sdk/src/index.ts",
      "^@kaleido-io/connector-sdk/(.+)$": "<rootDir>/../connector-sdk/src/$1/index.ts",
      "^@kaleido-io/core$": "<rootDir>/../../internal/core/src/index.ts",
      "^@kaleido-io/core/(.+)$": "<rootDir>/../../internal/core/src/$1/index.ts",
      "^(\\.{1,2}/.*)\\.js$": "$1"
    },
    "maxWorkers": 1,
    "coverageProvider": "v8"
  },
  "sideEffects": false
}
