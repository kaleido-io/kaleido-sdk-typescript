{
  "name": "@kaleido-io/core-sdk",
  "version": "1.0.0-rc1",
  "description": "Core utilities for Kaleido SDKs — HTTP transport, logging, and service-binding resolution",
  "type": "module",
  "main": "dist/src/index.js",
  "types": "dist/src/index.d.ts",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kaleido-io/kaleido-sdk-typescript.git"
  },
  "typesVersions": {
    "*": {
      "http": [
        "./dist/src/http/index.d.ts"
      ],
      "log": [
        "./dist/src/log/index.d.ts"
      ],
      "context": [
        "./dist/src/context/index.d.ts"
      ]
    }
  },
  "exports": {
    ".": {
      "import": "./dist/src/index.js",
      "types": "./dist/src/index.d.ts"
    },
    "./http": {
      "import": "./dist/src/http/index.js",
      "types": "./dist/src/http/index.d.ts"
    },
    "./log": {
      "import": "./dist/src/log/index.js",
      "types": "./dist/src/log/index.d.ts"
    },
    "./context": {
      "import": "./dist/src/context/index.js",
      "types": "./dist/src/context/index.d.ts"
    }
  },
  "scripts": {
    "prebuild": "npm run clean",
    "build": "tsc",
    "postbuild": "tsc-esm-fix --target='dist'",
    "clean": "rm -rf dist",
    "test": "jest --coverage",
    "dev": "tsc --watch"
  },
  "keywords": [
    "kaleido",
    "sdk",
    "typescript",
    "http",
    "logging",
    "service-binding"
  ],
  "author": "Kaleido",
  "license": "Apache-2.0",
  "files": [
    "dist/**/*",
    "README.md",
    "LICENSE"
  ],
  "dependencies": {
    "axios": "^1.13.0",
    "axios-retry": "^4.5.0",
    "cacheable-lookup": "^6.1.0",
    "js-yaml": "^4.1.1"
  },
  "devDependencies": {
    "@jest/globals": "^30.3.0",
    "@types/jest": "^30.0.0",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^22.0.0",
    "jest": "^30.3.0",
    "ts-jest": "^29.1.0",
    "tsc-esm-fix": "^3.1.2",
    "typescript": "^5.2.0"
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "node",
    "roots": [
      "<rootDir>/src"
    ],
    "testMatch": [
      "**/?(*.)+(spec|test).ts"
    ],
    "transform": {
      "^.+\\.ts$": "ts-jest"
    },
    "moduleNameMapper": {
      "^(\\.{1,2}/.*)\\.js$": "$1"
    },
    "maxWorkers": 1,
    "coverageProvider": "v8"
  },
  "engines": {
    "node": ">=20"
  },
  "sideEffects": false
}
