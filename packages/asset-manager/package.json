{
  "name": "@kaleido-io/asset-manager-sdk",
  "version": "0.1.0",
  "description": "TypeScript SDK client for the Kaleido Asset Manager service",
  "type": "module",
  "main": "dist/src/index.js",
  "types": "dist/src/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/src/index.js",
      "types": "./dist/src/index.d.ts"
    }
  },
  "scripts": {
    "prebuild": "npm run clean",
    "build": "tsc",
    "postbuild": "tsc-esm-fix --target='dist'",
    "clean": "rm -rf dist",
    "dev": "tsc --watch",
    "test": "jest --coverage"
  },
  "files": [
    "dist/**/*",
    "README.md"
  ],
  "license": "Apache-2.0",
  "dependencies": {
    "@kaleido-io/core": "file:../core",
    "deepmerge": "^4.3.1",
    "zod": "^3.0.0"
  },
  "devDependencies": {
    "@jest/globals": "^30.0.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^22.0.0",
    "jest": "^30.0.0",
    "ts-jest": "^29.1.0",
    "tsc-esm-fix": "^3.1.2",
    "typescript": "^5.2.0"
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "node",
    "roots": ["<rootDir>/src"],
    "testMatch": ["**/?(*.)+(spec|test).ts"],
    "transform": {
      "^.+\\.ts$": "ts-jest"
    },
    "moduleNameMapper": {
      "^(\\.{1,2}/.*)\\.js$": "$1"
    },
    "maxWorkers": 1,
    "coverageProvider": "v8"
  },
  "engines": {
    "node": ">=20"
  }
}