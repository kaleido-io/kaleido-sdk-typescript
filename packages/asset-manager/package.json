{
  "name": "@kaleido-io/asset-manager-sdk",
  "version": "0.1.0",
  "description": "TypeScript SDK client for the Kaleido Asset Manager service",
  "type": "module",
  "main": "dist/src/index.js",
  "types": "dist/src/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/src/index.js",
      "types": "./dist/src/index.d.ts"
    }
  },
  "scripts": {
    "build": "tsup",
    "clean": "rm -rf dist",
    "dev": "tsc --watch",
    "test": "jest --coverage"
  },
  "files": [
    "dist/**/*",
    "README.md"
  ],
  "license": "Apache-2.0",
  "dependencies": {
    "@kaleido-io/workflow-engine-sdk": "*",
    "deepmerge": "^4.3.1",
    "zod": "^3.0.0"
  },
  "devDependencies": {
    "@kaleido-io/core": "file:../../internal/core",
    "@jest/globals": "^30.0.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^22.0.0",
    "jest": "^30.0.0",
    "ts-jest": "^29.1.0",
    "tsc-esm-fix": "^3.1.2",
    "tsup": "^8.5.1",
    "typescript": "^5.2.0"
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "node",
    "roots": [
      "<rootDir>/src"
    ],
    "testMatch": [
      "**/?(*.)+(spec|test).ts"
    ],
    "transform": {
      "^.+\\.ts$": "ts-jest"
    },
    "moduleNameMapper": {
      "^@kaleido-io/workflow-engine-sdk$": "<rootDir>/../workflow-engine-sdk/src/index.ts",
      "^@kaleido-io/core/(.+)$": "<rootDir>/../../internal/core/src/$1/index.ts",
      "^(\\.{1,2}/.*)\\.js$": "$1"
    },
    "maxWorkers": 1,
    "coverageProvider": "v8"
  },
  "engines": {
    "node": ">=20"
  },
  "sideEffects": false
}
