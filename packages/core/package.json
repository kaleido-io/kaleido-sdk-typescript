{
  "name": "@kaleido-io/core",
  "version": "0.1.0",
  "description": "Core utilities for Kaleido SDKs",
  "type": "module",
  "main": "dist/src/index.js",
  "types": "dist/src/index.d.ts",
  "typesVersions": {
    "*": {
      "http": [
        "./dist/src/http/index.d.ts"
      ]
    }
  },
  "exports": {
    ".": {
      "import": "./dist/src/index.js",
      "types": "./dist/src/index.d.ts"
    },
    "./http": {
      "import": "./dist/src/http/index.js",
      "types": "./dist/src/http/index.d.ts"
    }
  },
  "scripts": {
    "prebuild": "npm run clean",
    "build": "tsc",
    "postbuild": "tsc-esm-fix --target='dist'",
    "clean": "rm -rf dist",
    "test": "jest --coverage",
    "dev": "tsc --watch"
  },
  "files": [
    "dist/**/*",
    "README.md"
  ],
  "license": "Apache-2.0",
  "dependencies": {
    "axios": "^1.13.0",
    "axios-retry": "^4.5.0",
    "cacheable-lookup": "^6.1.0"
  },
  "devDependencies": {
    "@jest/globals": "^30.3.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^22.0.0",
    "jest": "^30.3.0",
    "tsc-esm-fix": "^3.1.2",
    "typescript": "^5.2.0"
  },
  "engines": {
    "node": ">=20"
  }
}
