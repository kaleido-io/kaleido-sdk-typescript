{
  "name": "@kaleido-io/workflow-engine-sdk",
  "version": "1.1.0-rc.1",
  "description": "TypeScript SDK for Kaleido Workflow Engine",
  "type": "module",
  "main": "dist/src/index.js",
  "types": "dist/src/index.d.ts",
  "typesVersions": {
    "*": {
      "testing": [
        "./dist/src/testing/index.d.ts"
      ],
      "snippet-package": [
        "./dist/src/snippet-package/index.d.ts"
      ]
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kaleido-io/kaleido-sdk-typescript.git"
  },
  "scripts": {
    "prebuild": "npm run lint",
    "build": "tsc",
    "postbuild": "tsc-esm-fix --target='dist'",
    "clean": "rm -rf dist",
    "dev": "tsc --watch",
    "test": "jest --testPathIgnorePatterns=tests/componenttest --coverage",
    "test:unit": "jest tests/unit",
    "test:component": "jest tests/componenttest",
    "test:all": "jest --coverage",
    "lint": "eslint . --config eslint.config.mjs",
    "api:check": "for c in api-extractor*.json; do api-extractor run -c $c || exit 1; done",
    "api:update": "for c in api-extractor*.json; do api-extractor run --local -c $c || exit 1; done",
    "lint:fix": "eslint . --fix --config eslint.config.mjs"
  },
  "keywords": [
    "kaleido",
    "sdk",
    "typescript",
    "workflows",
    "workflow-engine",
    "handlers",
    "providers"
  ],
  "author": "Kaleido",
  "license": "Apache-2.0",
  "dependencies": {
    "@kaleido-io/core-sdk": "^1.1.0-rc.1",
    "axios": "^1.13.0",
    "exponential-backoff": "^3.1.1",
    "fast-json-patch": "^3.1.1",
    "js-yaml": "^4.1.1",
    "ws": "^8.14.0",
    "yauzl": "^3.4.0",
    "yazl": "^3.3.1"
  },
  "devDependencies": {
    "@eslint/compat": "^2.0.0",
    "@eslint/js": "^10.0.0",
    "@jest/globals": "^30.2.0",
    "@microsoft/api-extractor": "^7.59.2",
    "@types/jest": "^30.0.0",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^25.2.1",
    "@types/ws": "^8.5.0",
    "@types/yauzl": "^3.4.0",
    "@types/yazl": "^3.3.1",
    "esbuild": "^0.28.0",
    "eslint": "^10.0.0",
    "eslint-plugin-notice": "^1.0.0",
    "find-root": "^1.1.0",
    "globals": "^17.3.0",
    "jest": "^30.2.0",
    "lodash": "^4.17.21",
    "metric-lcs": "^1.0.3",
    "ts-jest": "^29.1.0",
    "ts-node": "^10.9.2",
    "tsc-esm-fix": "^3.1.2",
    "typescript": "^5.2.0",
    "typescript-eslint": "^8.56.0"
  },
  "engines": {
    "node": ">=20.19.0"
  },
  "files": [
    "dist/**/*",
    "README.md",
    "LICENSE"
  ],
  "exports": {
    ".": {
      "import": "./dist/src/index.js",
      "types": "./dist/src/index.d.ts"
    },
    "./testing": {
      "import": "./dist/src/testing/index.js",
      "types": "./dist/src/testing/index.d.ts"
    },
    "./snippet-package": {
      "import": "./dist/src/snippet-package/index.js",
      "types": "./dist/src/snippet-package/index.d.ts"
    }
  },
  "sideEffects": false,
  "peerDependencies": {
    "esbuild": ">=0.25.0"
  },
  "peerDependenciesMeta": {
    "esbuild": {
      "optional": true
    }
  }
}
