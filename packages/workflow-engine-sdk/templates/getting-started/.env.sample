# Copy this file to .env and fill in your values.

# Kaleido account/environment/service identifiers — used by the utility scripts
# (post-workflow.ts, post-transaction.ts, post-stream.ts) to build the REST API URL.
# Find these in the Kaleido console under your environment's workflow engine endpoint.
# The URL will be: https://<ACCOUNT>/endpoint/<ENVIRONMENT>/<WORKFLOW_ENGINE>/rest
ACCOUNT=
ENVIRONMENT=
WORKFLOW_ENGINE=

# Basic auth credentials for the utility scripts — must match your wfe-config.yaml auth values
KEY_NAME=
KEY_VALUE=

# Path to the Workflow Engine connection config (default: ./config/wfe-config.yaml)
# WFE_CONFIG_FILE=./config/wfe-config.yaml

# Path to the application config (default: ./config/config.yaml)
# CONFIG_FILE=./config/config.yaml

# API key for the http-invoke sample handler
API_KEY=
