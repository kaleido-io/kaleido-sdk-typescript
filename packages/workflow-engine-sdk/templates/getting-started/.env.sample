# Copy this file to .env and fill in your values.
# .env is gitignored — never commit real credentials.

# Kaleido platform identifiers — used by the create-workflow, create-transaction,
# and create-stream utility scripts to build the REST API URL:
# https://{ACCOUNT}/endpoint/{ENVIRONMENT}/{WORKFLOW_ENGINE}/rest
ACCOUNT=<your-account>.kaleido.io
ENVIRONMENT=<your-environment-id>
WORKFLOW_ENGINE=<your-workflow-engine-id>

# Kaleido API key credentials — used by the utility scripts for REST API auth
KEY_NAME=<api-key-name>
KEY_VALUE=<api-key-password>

# API key for the http-invoke sample (header name is set in config/config.yaml)
# Only needed if you point httpInvoke.url at an API that requires authentication
API_KEY=your-api-key-here
