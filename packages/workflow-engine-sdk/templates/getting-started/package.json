{
    "name": "{{PROVIDER_NAME}}",
    "version": "0.0.1",
    "scripts": {
        "prebuild": "npm run clean",
        "build": "tsc",
        "clean": "rm -rf dist",
        "start": "node dist/src/connect.js",
        "start:dev": "tsx ./src/connect.ts",
        "create-workflow": "tsx ./src/utils/post-workflow.ts",
        "create-transaction": "tsx ./src/utils/post-transaction.ts",
        "create-stream": "tsx ./src/utils/post-stream.ts",
        "test": "vitest run",
        "test:watch": "vitest watch",
        "test:coverage": "vitest run --coverage",
        "package:docker": "docker build --platform linux/amd64 -t {{PROVIDER_NAME}}:latest .",
        "package:podman": "podman build --platform linux/amd64 -t {{PROVIDER_NAME}}:latest .",
        "promote:docker": "docker tag {{PROVIDER_NAME}}:latest ${ARTIFACT_REGISTRY}/{{PROVIDER_NAME}}:${IMAGE_TAG} && docker push ${ARTIFACT_REPOSITORY}/{{PROVIDER_NAME}}:${IMAGE_TAG}",
        "promote:podman": "podman tag {{PROVIDER_NAME}}:latest ${ARTIFACT_REGISTRY}/{{PROVIDER_NAME}}:${IMAGE_TAG} && podman push ${ARTIFACT_REGISTRY}/{{PROVIDER_NAME}}:${IMAGE_TAG}",
        "promote:crane": "crane copy ${SOURCE_REGISTRY}/{{PROVIDER_NAME}}:${IMAGE_TAG} ${ARTIFACT_REGISTRY}/{{PROVIDER_NAME}}:${IMAGE_TAG}"
    },
    "private": true,
    "devDependencies": {
        "@types/js-yaml": "^4.0.9",
        "@vitest/coverage-v8": "^4.0.16",
        "tsx": "^4.21.0",
        "typescript": "^5.9.3",
        "vitest": "^4.0.16"
    },
    "type": "module",
    "main": "dist/src/connect.js",
    "files": [
        "dist/src",
        "README.md"
    ],
    "dependencies": {
        "@kaleido-io/workflow-engine-sdk": "file:../..",
        "dotenv": "^17.2.3",
        "js-yaml": "^4.1.1",
        "web3": "^4.16.0",
        "ws": "^8.18.0"
    }
}