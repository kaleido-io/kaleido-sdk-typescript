# Copy this file to .env and fill in your values.
# .env is gitignored — never commit real credentials.

# Override the default config file paths (optional)
# WFE_CONFIG_FILE=./config/wfe-config.yaml
# CONFIG_FILE=./config/provider-config.yaml

# Used by npm run patch-provider-runtime
# RUNTIME_NAME=erc20-indexer-runtime
# IMAGE_REPOSITORY=my-namespace/{{PROVIDER_NAME}}
# IMAGE_TAG=v1
