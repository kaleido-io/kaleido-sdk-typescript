{
  "name": "{{PROVIDER_NAME}}",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "main": "dist/src/connect.js",
  "scripts": {
    "prebuild": "npm run clean",
    "build": "tsc",
    "clean": "rm -rf dist",
    "start": "node dist/src/connect.js",
    "start:dev": "tsx ./src/connect.ts",
    "create-stream": "tsx ./src/utils/post-stream.ts",
    "test": "vitest run",
    "test:watch": "vitest watch",
    "test:coverage": "vitest run --coverage",
    "package:docker": "docker build --platform linux/amd64 -t {{PROVIDER_NAME}}:latest .",
    "package:podman": "podman build --platform linux/amd64 -t {{PROVIDER_NAME}}:latest .",
    "promote:docker": "docker tag {{PROVIDER_NAME}}:latest ${ARTIFACT_REGISTRY}/{{PROVIDER_NAME}}:${IMAGE_TAG} && docker push ${ARTIFACT_REGISTRY}/{{PROVIDER_NAME}}:${IMAGE_TAG}",
    "promote:podman": "podman tag {{PROVIDER_NAME}}:latest ${ARTIFACT_REGISTRY}/{{PROVIDER_NAME}}:${IMAGE_TAG} && podman push ${ARTIFACT_REGISTRY}/{{PROVIDER_NAME}}:${IMAGE_TAG}",
    "promote:crane": "crane copy ${SOURCE_REGISTRY}/{{PROVIDER_NAME}}:${IMAGE_TAG} ${ARTIFACT_REGISTRY}/{{PROVIDER_NAME}}:${IMAGE_TAG}",
    "patch-provider-runtime": "tsx ./src/utils/patch-provider-runtime.ts"
  },
  "dependencies": {
    "@kaleido-io/workflow-engine-sdk": "^0.9.6",
    "axios": "^1.13.0",
    "axios-retry": "^4.5.0",
    "dotenv": "^17.0.0",
    "js-yaml": "^4.1.1"
  },
  "devDependencies": {
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^25.5.2",
    "@vitest/coverage-v8": "^4.0.0",
    "tsx": "^4.21.0",
    "typescript": "^5.9.0",
    "vitest": "^4.0.0"
  }
}
