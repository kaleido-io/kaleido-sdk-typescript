{
  "name": "@kaleido-io/asset-manager-sdk",
  "version": "1.0.0-rc2",
  "description": "TypeScript SDK client for the Kaleido Asset Manager service",
  "type": "module",
  "main": "dist/src/index.js",
  "types": "dist/src/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/src/index.js",
      "types": "./dist/src/index.d.ts"
    }
  },
  "scripts": {
    "prebuild": "npm run clean",
    "build": "tsc",
    "postbuild": "tsc-esm-fix --target='dist'",
    "clean": "rm -rf dist",
    "dev": "tsc --watch",
    "lint": "eslint . --config eslint.config.mjs",
    "test": "jest --coverage"
  },
  "files": [
    "dist/**/*",
    "README.md",
    "LICENSE"
  ],
  "license": "Apache-2.0",
  "dependencies": {
    "@kaleido-io/core-sdk": "^1.0.0-rc2",
    "deepmerge": "^4.3.1"
  },
  "devDependencies": {
    "@eslint/compat": "^2.0.0",
    "@eslint/js": "^10.0.0",
    "@jest/globals": "^30.0.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^22.0.0",
    "eslint": "^10.0.0",
    "eslint-plugin-notice": "^1.0.0",
    "globals": "^17.3.0",
    "jest": "^30.0.0",
    "ts-jest": "^29.1.0",
    "tsc-esm-fix": "^3.1.2",
    "typescript": "^5.2.0",
    "typescript-eslint": "^8.56.0"
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "node",
    "roots": [
      "<rootDir>/src"
    ],
    "testMatch": [
      "**/?(*.)+(spec|test).ts"
    ],
    "transform": {
      "^.+\\.ts$": "ts-jest"
    },
    "moduleNameMapper": {
      "^@kaleido-io/core-sdk$": "<rootDir>/../core-sdk/src/index.ts",
      "^@kaleido-io/core-sdk/(.+)$": "<rootDir>/../core-sdk/src/$1/index.ts",
      "^(\\.{1,2}/.*)\\.js$": "$1"
    },
    "maxWorkers": 1,
    "coverageProvider": "v8"
  },
  "engines": {
    "node": ">=20"
  },
  "sideEffects": false
}
