# Provider configuration for the ERC-20 Indexer.
# Set CONFIG_FILE env var to point to this file (default: ./config/provider-config.yaml).

# Asset Manager connection — where indexed transfers are written.
assetManager:
  account: my-account.my-kaleido.io
  environment: my-environment
  serviceName: assets-asset-manager
  auth:
    keyName: my-api-key-name
    keyValue: my-api-key

# ERC-20 contract to index
erc20:
  contractAddress: '0x..'
  contractName: Token Name
  contractSymbol: TKN
  chain: ethereum          # Informational label attached to indexed transfers

# Service ID of the EVM Connector provider (used when creating the event stream)
evmConnector: s:my-evm-connector-service-id
