# Build from monorepo root: docker build -f samples/workflow-engine-provider/Dockerfile.withsdk .
FROM node:22-bookworm-slim AS builder

WORKDIR /app

# Install all workspace deps from the root lockfile
COPY package.json package-lock.json ./
COPY internal/core/package.json ./internal/core/
COPY packages/workflow-engine-sdk/package.json ./packages/workflow-engine-sdk/
COPY packages/asset-manager-sdk/package.json ./packages/asset-manager-sdk/
COPY samples/workflow-engine-provider/package.json ./samples/workflow-engine-provider/

RUN npm ci

# Build internal/core
COPY internal/core ./internal/core
RUN npm run build --prefix internal/core

# Build workspace packages
COPY packages/workflow-engine-sdk ./packages/workflow-engine-sdk
COPY packages/asset-manager-sdk ./packages/asset-manager-sdk
RUN npm run build -w packages/workflow-engine-sdk -w packages/asset-manager-sdk

# Build the sample — source lives at root level (no src/ subdir)
COPY samples/workflow-engine-provider/tsconfig.json ./samples/workflow-engine-provider/
COPY samples/workflow-engine-provider/connect.ts ./samples/workflow-engine-provider/
COPY samples/workflow-engine-provider/provider.ts ./samples/workflow-engine-provider/
COPY samples/workflow-engine-provider/block-indexer ./samples/workflow-engine-provider/block-indexer
COPY samples/workflow-engine-provider/event-source ./samples/workflow-engine-provider/event-source
COPY samples/workflow-engine-provider/hello ./samples/workflow-engine-provider/hello
COPY samples/workflow-engine-provider/http-invoke ./samples/workflow-engine-provider/http-invoke
COPY samples/workflow-engine-provider/list-pools ./samples/workflow-engine-provider/list-pools
COPY samples/workflow-engine-provider/snap ./samples/workflow-engine-provider/snap
COPY samples/workflow-engine-provider/utils ./samples/workflow-engine-provider/utils
RUN npm run build -w samples/workflow-engine-provider

# Runtime stage — distroless for minimal attack surface and image size
FROM gcr.io/distroless/nodejs22-debian12

WORKDIR /app

COPY --from=builder /app/node_modules ./node_modules
COPY --from=builder /app/samples/workflow-engine-provider/dist ./samples/workflow-engine-provider/dist
COPY --from=builder /app/samples/workflow-engine-provider/package.json ./samples/workflow-engine-provider/
# Workspace package dist dirs — required so npm symlinks in node_modules resolve
COPY --from=builder /app/internal/core/dist ./internal/core/dist
COPY --from=builder /app/internal/core/package.json ./internal/core/package.json
COPY --from=builder /app/packages/workflow-engine-sdk/dist ./packages/workflow-engine-sdk/dist
COPY --from=builder /app/packages/workflow-engine-sdk/package.json ./packages/workflow-engine-sdk/package.json
COPY --from=builder /app/packages/asset-manager-sdk/dist ./packages/asset-manager-sdk/dist
COPY --from=builder /app/packages/asset-manager-sdk/package.json ./packages/asset-manager-sdk/package.json

ENV KALEIDO_CONFIG_FILE=./config/wfe-config.yaml
ENV WFE_CONFIG_FILE=./config/wfe-config.yaml
ENV CONFIG_FILE=./config/config.yaml

# distroless/nodejs images run as nonroot (uid 65532) by default
USER nonroot

CMD ["/app/samples/workflow-engine-provider/dist/connect.js"]
