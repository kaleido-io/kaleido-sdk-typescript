# Build from monorepo root: docker build -f samples/getting-started/Dockerfile.withsdk .
FROM node:22-bookworm-slim AS builder

WORKDIR /app

# Install all workspace deps from the root lockfile
COPY package.json package-lock.json ./
COPY internal/core/package.json ./internal/core/
COPY packages/workflow-engine-sdk/package.json ./packages/workflow-engine-sdk/
COPY packages/asset-manager/package.json ./packages/asset-manager/
COPY samples/getting-started/package.json ./samples/getting-started/

RUN npm ci

# Build internal/core
COPY internal/core ./internal/core
RUN npm run build --prefix internal/core

# Build workspace packages
COPY packages/workflow-engine-sdk ./packages/workflow-engine-sdk
COPY packages/asset-manager ./packages/asset-manager
RUN npm run build -w packages/workflow-engine-sdk -w packages/asset-manager

# Build the sample — source lives at root level (no src/ subdir)
COPY samples/getting-started/tsconfig.json ./samples/getting-started/
COPY samples/getting-started/connect.ts ./samples/getting-started/
COPY samples/getting-started/provider.ts ./samples/getting-started/
COPY samples/getting-started/block-indexer ./samples/getting-started/block-indexer
COPY samples/getting-started/event-source ./samples/getting-started/event-source
COPY samples/getting-started/hello ./samples/getting-started/hello
COPY samples/getting-started/http-invoke ./samples/getting-started/http-invoke
COPY samples/getting-started/list-pools ./samples/getting-started/list-pools
COPY samples/getting-started/snap ./samples/getting-started/snap
COPY samples/getting-started/utils ./samples/getting-started/utils
RUN npm run build -w samples/getting-started

# Runtime stage — distroless for minimal attack surface and image size
FROM gcr.io/distroless/nodejs22-debian12

WORKDIR /app

COPY --from=builder /app/node_modules ./node_modules
COPY --from=builder /app/samples/getting-started/dist ./samples/getting-started/dist
COPY --from=builder /app/samples/getting-started/package.json ./samples/getting-started/
# Workspace package dist dirs — required so npm symlinks in node_modules resolve
COPY --from=builder /app/internal/core/dist ./internal/core/dist
COPY --from=builder /app/internal/core/package.json ./internal/core/package.json
COPY --from=builder /app/packages/workflow-engine-sdk/dist ./packages/workflow-engine-sdk/dist
COPY --from=builder /app/packages/workflow-engine-sdk/package.json ./packages/workflow-engine-sdk/package.json
COPY --from=builder /app/packages/asset-manager/dist ./packages/asset-manager/dist
COPY --from=builder /app/packages/asset-manager/package.json ./packages/asset-manager/package.json

ENV KALEIDO_CONFIG_FILE=./config/wfe-config.yaml
ENV WFE_CONFIG_FILE=./config/wfe-config.yaml
ENV CONFIG_FILE=./config/config.yaml

# distroless/nodejs images run as nonroot (uid 65532) by default
USER nonroot

CMD ["/app/samples/getting-started/dist/connect.js"]
