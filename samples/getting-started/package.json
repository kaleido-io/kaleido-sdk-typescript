{
    "name": "getting-started",
    "version": "0.0.1",
    "scripts": {
        "prebuild": "npm run clean",
        "build": "tsc",
        "clean": "rm -rf dist",
        "start": "node dist/connect.js",
        "start:dev": "tsx ./connect.ts",
        "create-workflow": "tsx ./utils/post-workflow.ts",
        "create-transaction": "tsx ./utils/post-transaction.ts",
        "create-stream": "tsx ./utils/post-stream.ts",
        "test": "vitest run",
        "test:watch": "vitest watch",
        "test:coverage": "vitest run --coverage",
        "package:docker": "docker build --platform linux/amd64 -t getting-started-provider:latest .",
        "package:podman": "podman build --platform linux/amd64 -t getting-started-provider:latest .",
        "promote:docker": "docker tag getting-started-provider:latest ${ARTIFACT_REGISTRY}/getting-started-provider:${IMAGE_TAG} && docker push ${ARTIFACT_REGISTRY}/getting-started-provider:${IMAGE_TAG}",
        "promote:podman": "podman tag getting-started-provider:latest ${ARTIFACT_REGISTRY}/getting-started-provider:${IMAGE_TAG} && podman push ${ARTIFACT_REGISTRY}/getting-started-provider:${IMAGE_TAG}",
        "promote:crane": "crane copy ${SOURCE_REGISTRY}/getting-started-provider:${IMAGE_TAG} ${ARTIFACT_REGISTRY}/getting-started-provider:${IMAGE_TAG}",
        "promote:crane-local": "crane copy --insecure daemon://getting-started-provider:latest ${ARTIFACT_REGISTRY}/getting-started-provider:${IMAGE_TAG}",
        "promote:kind-local": "docker tag getting-started-provider:latest localhost:6001/getting-started-provider:${IMAGE_TAG} && docker push localhost:6001/getting-started-provider:${IMAGE_TAG}"
    },
    "private": true,
    "devDependencies": {
        "@types/js-yaml": "^4.0.9",
        "@vitest/coverage-v8": "^4.0.16",
        "tsx": "^4.21.0",
        "typescript": "^5.9.3",
        "vitest": "^4.0.16"
    },
    "type": "module",
    "main": "dist/connect.js",
    "files": [
        "dist",
        "README.md"
    ],
    "dependencies": {
        "@kaleido-io/workflow-engine-sdk": "*",
        "@kaleido-io/asset-manager-sdk": "*",
        "dotenv": "^17.2.3",
        "js-yaml": "^4.1.1",
        "web3": "^4.16.0",
        "ws": "^8.18.0"
    }
}
