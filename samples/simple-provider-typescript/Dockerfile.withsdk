# Build from monorepo root:
#   docker build -f samples/simple-provider-typescript/Dockerfile.withsdk -t simple-provider-typescript:latest .
FROM node:22-bookworm-slim AS builder

WORKDIR /app

COPY package.json package-lock.json ./
COPY packages/core-sdk/package.json ./packages/core-sdk/
COPY packages/workflow-engine-sdk/package.json ./packages/workflow-engine-sdk/
COPY samples/simple-provider-typescript/package.json ./samples/simple-provider-typescript/

RUN npm ci

COPY packages/core-sdk ./packages/core-sdk
RUN npm run build -w packages/core-sdk

COPY packages/workflow-engine-sdk ./packages/workflow-engine-sdk
RUN npm run build -w packages/workflow-engine-sdk

COPY samples/simple-provider-typescript/tsconfig.json ./samples/simple-provider-typescript/
COPY samples/simple-provider-typescript/connect.ts ./samples/simple-provider-typescript/
COPY samples/simple-provider-typescript/provider.ts ./samples/simple-provider-typescript/
COPY samples/simple-provider-typescript/handlers-config.ts ./samples/simple-provider-typescript/
COPY samples/simple-provider-typescript/register-handlers.ts ./samples/simple-provider-typescript/
COPY samples/simple-provider-typescript/hot-reload.ts ./samples/simple-provider-typescript/
COPY samples/simple-provider-typescript/handlers ./samples/simple-provider-typescript/handlers
RUN npm run build -w samples/simple-provider-typescript

FROM gcr.io/distroless/nodejs22-debian12

WORKDIR /app

COPY --from=builder /app/node_modules ./node_modules
COPY --from=builder /app/samples/simple-provider-typescript/dist ./samples/simple-provider-typescript/dist
COPY --from=builder /app/samples/simple-provider-typescript/package.json ./samples/simple-provider-typescript/
COPY --from=builder /app/packages/core-sdk/dist ./packages/core-sdk/dist
COPY --from=builder /app/packages/core-sdk/package.json ./packages/core-sdk/package.json
COPY --from=builder /app/packages/workflow-engine-sdk/dist ./packages/workflow-engine-sdk/dist
COPY --from=builder /app/packages/workflow-engine-sdk/package.json ./packages/workflow-engine-sdk/package.json
COPY samples/simple-provider-typescript/config ./samples/simple-provider-typescript/config

ENV KALEIDO_CONFIG_FILE=./config/config.yaml
ENV CONFIG_FILE=./config/provider-config.json

WORKDIR /app/samples/simple-provider-typescript

USER nonroot

CMD ["dist/connect.js"]
