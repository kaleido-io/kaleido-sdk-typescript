# Build from monorepo root: docker build -f samples/native-eth-indexer/Dockerfile.withsdk .
FROM node:22-bookworm-slim AS builder

WORKDIR /app

# Copy workspace manifests first for layer caching
COPY package.json package-lock.json ./
COPY packages/core/package.json ./packages/core/
COPY packages/asset-manager/package.json ./packages/asset-manager/
COPY packages/workflow-engine-sdk/package.json ./packages/workflow-engine-sdk/
COPY samples/native-eth-indexer/package.json ./samples/native-eth-indexer/

RUN npm ci

# Copy workspace package sources
COPY packages ./packages
COPY samples/native-eth-indexer/tsconfig.json ./samples/native-eth-indexer/
COPY samples/native-eth-indexer/src ./samples/native-eth-indexer/src

# Build in dependency order
RUN npm run build -w packages/core && \
    npm run build -w packages/workflow-engine-sdk && \
    npm run build -w packages/asset-manager && \
    npm run build -w samples/native-eth-indexer

# Runtime stage — distroless for minimal attack surface and image size
# No shell, no package manager: only the Node runtime and your compiled JS.
FROM gcr.io/distroless/nodejs22-debian12

WORKDIR /app

COPY --from=builder /app/ ./

ADD ./samples/native-eth-indexer/config/config.yaml ./config/config.yaml

ENV CONFIG_FILE=./config/config.yaml

# distroless node images use nonroot (uid 65532) by default
USER nonroot

CMD ["/app/samples/native-eth-indexer/dist/src/main.js"]
