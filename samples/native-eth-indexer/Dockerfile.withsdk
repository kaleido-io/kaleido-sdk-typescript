# Build from monorepo root: docker build -f samples/native-eth-indexer/Dockerfile.withsdk .
FROM node:22-bookworm-slim AS builder

WORKDIR /app

# Copy workspace manifests first for layer caching
COPY package.json package-lock.json ./
COPY packages/core-sdk/package.json ./packages/core-sdk/
COPY packages/asset-manager-sdk/package.json ./packages/asset-manager-sdk/
COPY packages/connector-sdk/package.json ./packages/connector-sdk/
COPY packages/workflow-engine-sdk/package.json ./packages/workflow-engine-sdk/
COPY samples/native-eth-indexer/package.json ./samples/native-eth-indexer/

RUN npm ci

# Build packages/core-sdk
COPY packages/core-sdk ./packages/core-sdk
RUN npm run build -w packages/core-sdk

# Build workspace packages
COPY packages/workflow-engine-sdk ./packages/workflow-engine-sdk
COPY packages/asset-manager-sdk ./packages/asset-manager-sdk
COPY packages/connector-sdk ./packages/connector-sdk
RUN npm run build -w packages/workflow-engine-sdk -w packages/asset-manager-sdk -w packages/connector-sdk

# Build the sample
COPY samples/native-eth-indexer/tsconfig.json ./samples/native-eth-indexer/
COPY samples/native-eth-indexer/src ./samples/native-eth-indexer/src
RUN npm run build -w samples/native-eth-indexer

# Runtime stage — distroless for minimal attack surface and image size
# No shell, no package manager: only the Node runtime and your compiled JS.
FROM gcr.io/distroless/nodejs22-debian12

WORKDIR /app

# node_modules contains symlinks like @kaleido-io/workflow-engine-sdk →
# ../../packages/workflow-engine-sdk, so the built package directories must be
# copied too or the symlinks will be dangling and Node will fail at import
# time with ERR_MODULE_NOT_FOUND.
COPY --from=builder /app/node_modules ./node_modules
COPY --from=builder /app/packages/core-sdk/dist ./packages/core-sdk/dist
COPY --from=builder /app/packages/core-sdk/package.json ./packages/core-sdk/package.json
COPY --from=builder /app/packages/workflow-engine-sdk/dist ./packages/workflow-engine-sdk/dist
COPY --from=builder /app/packages/workflow-engine-sdk/package.json ./packages/workflow-engine-sdk/package.json
COPY --from=builder /app/packages/asset-manager-sdk/dist ./packages/asset-manager-sdk/dist
COPY --from=builder /app/packages/asset-manager-sdk/package.json ./packages/asset-manager-sdk/package.json
COPY --from=builder /app/packages/connector-sdk/dist ./packages/connector-sdk/dist
COPY --from=builder /app/packages/connector-sdk/package.json ./packages/connector-sdk/package.json
COPY --from=builder /app/samples/native-eth-indexer/dist ./samples/native-eth-indexer/dist
COPY --from=builder /app/samples/native-eth-indexer/package.json ./samples/native-eth-indexer/

ENV CONFIG_FILE=./config/config.yaml

# distroless node images use nonroot (uid 65532) by default
USER nonroot

CMD ["/app/samples/native-eth-indexer/dist/src/main.js"]
