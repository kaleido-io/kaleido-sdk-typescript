{
  "name": "typescript-provider-package",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Handlers for the Kaleido TypeScript provider, uploaded as a snippet package",
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "package": "ksdk package"
  },
  "dependencies": {
    "@kaleido-io/core-sdk": "^1.1.0-rc.1",
    "@kaleido-io/workflow-engine-sdk": "^1.1.0-rc.1"
  },
  "devDependencies": {
    "@kaleido-io/kaleido-sdk": "^1.0.0",
    "@types/node": "^22.15.0",
    "typescript": "^5.9.3",
    "vitest": "^4.0.16"
  },
  "kaleido": {
    "transactionHandlers": [
      {
        "name": "hello",
        "entry": "src/transaction/hello.ts"
      }
    ],
    "eventSources": [
      {
        "name": "schedule",
        "entry": "src/eventsource/schedule.ts"
      }
    ],
    "eventProcessors": [
      {
        "name": "echo",
        "entry": "src/processor/echo.ts"
      }
    ]
  }
}
