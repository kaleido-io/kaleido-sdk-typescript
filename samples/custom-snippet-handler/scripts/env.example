# Copy to your shell or source before running upload-handlers.sh
#
# Admin REST API base (no trailing slash)
#
# Direct to artifact-registry (local / port-forward):
# export AREG_API="http://localhost:5600/api/v1"
#
# Kaleido platform (via API gateway — note /rest/api/v1):
# export AREG_API="https://account1.kaleido.dev/endpoint/env1/<artifact-registry-service>/rest/api/v1"
# export AREG_INSECURE=1   # local dev stacks with self-signed TLS only

export AREG_API="http://localhost:5600/api/v1"
export AREG_USER="your-user"
export AREG_PASSWORD="your-password"

# Optional: Bearer token instead of Basic
# export AREG_TOKEN="eyJ..."

# Namespace for TypeScript snippet files (artifact family: file)
export AREG_NS_FILE="platform-files-demo"

# Tag applied to every uploaded handler
export AREG_TAG="1.0.0"

# Optional prefix for repository names (repo = ${AREG_REPO_PREFIX}<handler-name>)
# export AREG_REPO_PREFIX="snippet-"

# Directory of handler .ts files (default: handlers/ next to this script's parent)
# export AREG_HANDLERS_DIR="/path/to/handlers"
