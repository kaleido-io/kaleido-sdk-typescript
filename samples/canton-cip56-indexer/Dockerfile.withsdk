# Build from monorepo root: docker build -f samples/canton-cip56-indexer/Dockerfile.withsdk .
FROM node:22-bookworm-slim AS builder

WORKDIR /app

# Copy workspace manifests first for layer caching
COPY package.json package-lock.json ./
COPY packages/core-sdk/package.json ./packages/core-sdk/
COPY packages/asset-manager-sdk/package.json ./packages/asset-manager-sdk/
COPY packages/connector-sdk/package.json ./packages/connector-sdk/
COPY packages/workflow-engine-sdk/package.json ./packages/workflow-engine-sdk/
COPY samples/canton-cip56-indexer/package.json ./samples/canton-cip56-indexer/

RUN npm ci

# Build packages/core-sdk
COPY packages/core-sdk ./packages/core-sdk
RUN npm run build -w packages/core-sdk

# Build workspace packages
COPY packages/workflow-engine-sdk ./packages/workflow-engine-sdk
COPY packages/asset-manager-sdk ./packages/asset-manager-sdk
COPY packages/connector-sdk ./packages/connector-sdk
RUN npm run build -w packages/workflow-engine-sdk -w packages/asset-manager-sdk -w packages/connector-sdk

# Build the sample
COPY samples/canton-cip56-indexer/tsconfig.json ./samples/canton-cip56-indexer/
COPY samples/canton-cip56-indexer/src ./samples/canton-cip56-indexer/src
RUN npm run build -w samples/canton-cip56-indexer

# Runtime stage — distroless for minimal attack surface and image size
# No shell, no package manager: only the Node runtime and your compiled JS.
FROM gcr.io/distroless/nodejs22-debian12

WORKDIR /app

COPY --from=builder /app/node_modules ./node_modules
COPY --from=builder /app/samples/canton-cip56-indexer/dist ./samples/canton-cip56-indexer/dist
COPY --from=builder /app/samples/canton-cip56-indexer/package.json ./samples/canton-cip56-indexer/

ENV CONFIG_FILE=./config/config.yaml

# distroless node images use nonroot (uid 65532) by default
USER nonroot

CMD ["/app/samples/canton-cip56-indexer/dist/src/connect.js"]
