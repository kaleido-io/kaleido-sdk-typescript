# Build from monorepo root: docker build -f samples/btc-indexer/Dockerfile.withsdk .
FROM node:22-bookworm-slim AS builder

WORKDIR /app

# Copy workspace manifests first for layer caching
COPY package.json package-lock.json ./
COPY internal/core/package.json ./internal/core/
COPY packages/asset-manager/package.json ./packages/asset-manager/
COPY packages/connector-sdk/package.json ./packages/connector-sdk/
COPY packages/workflow-engine-sdk/package.json ./packages/workflow-engine-sdk/
COPY samples/btc-indexer/package.json ./samples/btc-indexer/

RUN npm ci

# Build internal/core
COPY internal/core ./internal/core
RUN npm run build --prefix internal/core

# Build workspace packages
COPY packages/workflow-engine-sdk ./packages/workflow-engine-sdk
COPY packages/asset-manager ./packages/asset-manager
COPY packages/connector-sdk ./packages/connector-sdk
RUN npm run build -w packages/workflow-engine-sdk -w packages/asset-manager -w packages/connector-sdk

# Build the sample
COPY samples/btc-indexer/tsconfig.json ./samples/btc-indexer/
COPY samples/btc-indexer/src ./samples/btc-indexer/src
RUN npm run build -w samples/btc-indexer

# Runtime stage — distroless for minimal attack surface and image size
# No shell, no package manager: only the Node runtime and your compiled JS.
FROM gcr.io/distroless/nodejs22-debian12

WORKDIR /app

COPY --from=builder /app/node_modules ./node_modules
COPY --from=builder /app/samples/btc-indexer/dist ./samples/btc-indexer/dist
COPY --from=builder /app/samples/btc-indexer/package.json ./samples/btc-indexer/

ENV CONFIG_FILE=./config/config.yaml

# distroless node images use nonroot (uid 65532) by default
USER nonroot

CMD ["/app/samples/btc-indexer/dist/src/main.js"]
