{
  "name": "btc-indexer",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "main": "dist/src/main.js",
  "scripts": {
    "prebuild": "npm run clean",
    "build": "tsc",
    "clean": "rm -rf dist",
    "start": "node dist/src/main.js",
    "start:dev": "tsx ./src/main.ts",
    "test": "vitest run",
    "test:watch": "vitest watch",
    "test:coverage": "vitest run --coverage",
    "package:docker": "docker build --platform linux/amd64 -t btc-indexer:latest .",
    "package:podman": "podman build --platform linux/amd64 -t btc-indexer:latest .",
    "promote:docker": "docker tag btc-indexer:latest ${ARTIFACT_REGISTRY}/btc-indexer:${IMAGE_TAG} && docker push ${ARTIFACT_REGISTRY}/btc-indexer:${IMAGE_TAG}",
    "promote:podman": "podman tag btc-indexer:latest ${ARTIFACT_REGISTRY}/btc-indexer:${IMAGE_TAG} && podman push ${ARTIFACT_REGISTRY}/btc-indexer:${IMAGE_TAG}",
    "promote:crane": "crane copy ${SOURCE_REGISTRY}/btc-indexer:${IMAGE_TAG} ${ARTIFACT_REGISTRY}/btc-indexer:${IMAGE_TAG}",
    "patch-provider-runtime": "curl -s -f -X PUT \"${PLATFORM_URL}/api/v1/environments/${ENV_ID}/runtimes/${RUNTIME_NAME}\" -u \"${API_KEY}:${API_SECRET}\" -H 'Content-Type: application/json' -d '{\"name\":\"'\"${RUNTIME_NAME}\"'\",\"type\":\"ProviderRuntime\",\"image\":{\"repository\":\"'\"${IMAGE_REPOSITORY}\"'\",\"tag\":\"'\"${IMAGE_TAG:-latest}\"'\"}}'"
  },
  "dependencies": {
    "@kaleido-io/workflow-engine-sdk": "*",
    "@kaleido-io/connector-sdk": "*",
    "@kaleido-io/asset-manager-sdk": "*",
    "dotenv": "^17.0.0",
    "js-yaml": "^4.1.1"
  },
  "devDependencies": {
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^25.5.2",
    "@vitest/coverage-v8": "^4.0.0",
    "tsx": "^4.21.0",
    "typescript": "^5.9.0",
    "vitest": "^4.0.0"
  }
}
